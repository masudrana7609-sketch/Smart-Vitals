# Copy this file to .env and fill in your own values:   cp .env.example .env
# .env is ignored by Git. NEVER commit real secrets (START_HERE rule 2).
# Every value here is a placeholder, not a real secret.

# --- API security (R5) ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=30

# --- Database (R6) ---
# SQLite for local work and tests. Postgres in Docker, if we choose it:
#   DATABASE_URL=postgresql+psycopg://smartvitals:change-me@db:5432/smartvitals
DATABASE_URL=sqlite:///./data/smartvitals.db
POSTGRES_USER=smartvitals
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartvitals

# --- Model (R3): model v2 from notebook 02; its .json description sits next to it ---
MODEL_PATH=models/model_v2.joblib
RULE_SAFETY_NET=true

# --- MQTT feed (R2, R9) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=smartvitals/readings
MQTT_USERNAME=
MQTT_PASSWORD=
# Docker Compose: Mosquitto logins "devices" (may only publish) and "ingest" (may only read)
MQTT_DEVICE_PASSWORD=change-me
MQTT_INGEST_PASSWORD=change-me

# --- Simulator (R2, R9): 30 patients, 3 clinicians, 60x speed (A3, A4) ---
API_URL=http://localhost:8000
SIM_PATIENTS=30
SIM_CLINICIANS=3
SIM_SPEEDUP=60
SIM_SEED=42

# --- Alerts and retention (R4, R7): ADR 5, A6, A7 ---
# Minutes are simulated minutes while CLOCK=feed (A20); use CLOCK=wall for real devices
CLOCK=feed
ALERT_REMINDER_MINUTES=15
ESCALATION_SETTLE_MINUTES=5
LATE_AFTER_MINUTES=2
LATE_ALERT_MAX_MINUTES=30
STUCK_READINGS=10
READINGS_RETENTION_DAYS=30
ALERTS_RETENTION_DAYS=365

# --- Devices (R5): the simulator sends this with every HTTP reading (header X-Ingest-Key) ---
# Generate one the same way as SECRET_KEY. Empty: HTTP ingest is switched off.
INGEST_KEY=change-me

# --- Dashboard origin allowed by the API (CORS), as a JSON list ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Demo accounts (simulated people only) ---
# Logins: C01, C02, C03 (clinicians) and admin. At least 12 characters; stored only as argon2 hashes.
DEMO_CLINICIAN_PASSWORD=change-me
DEMO_ADMIN_PASSWORD=change-me
